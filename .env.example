# Copy to .env. With no keys at all, RELAY runs fully in mock mode (rule-based AI, simulated SMS/voice).

# --- mode ---
RELAY_MOCK_MODE=true            # true: mock LLM, mock embeddings, mock SMS/voice. Also forced on when GEMINI_API_KEY is empty.

# --- database ---
# Docker Compose sets this to PostgreSQL. Without Docker, the backend falls back to a local SQLite file.
DATABASE_URL=sqlite:///./relay_dev.db
# DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relay

# --- Google Gemini (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- SMS / voice provider (optional): mock | twilio | exotel | msg91 ---
SMS_PROVIDER=mock
SMS_FROM_NUMBER=+910000000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- privacy ---
PHONE_HASH_SALT=change-me       # phone numbers are stored only as salted hashes, shown masked

CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
